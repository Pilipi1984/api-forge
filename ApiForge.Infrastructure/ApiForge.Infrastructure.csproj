<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>True</IsPackable>
    <Description>ApiForge.Infrastructure is the infrastructure library of the ApiForge application, providing essential services and implementations for building and managing APIs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiForge.Application\ApiForge.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
