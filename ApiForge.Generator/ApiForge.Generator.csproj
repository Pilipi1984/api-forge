<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>ApiForge.Generator</PackageId>
		<Authors>Pilar Pérez de Inestrosa Sánchez</Authors>
		<Description>Generates a typed C# client solution (Domain/Application/Infrastructure/Client) from an OpenAPI spec, in-process — no HTTP call to ApiForge required.</Description>
		<PackageTags>openapi;codegen;client-generator;dotnet</PackageTags>
		<RepositoryUrl>https://github.com/Pilipi1984/api-forge</RepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Pilipi1984/api-forge</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApiForge.Domain\ApiForge.Domain.csproj" />
		<ProjectReference Include="..\ApiForge.Application\ApiForge.ApplicationCore.csproj" />
		<ProjectReference Include="..\ApiForge.Infrastructure\ApiForge.Infrastructure.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="MinVer" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>