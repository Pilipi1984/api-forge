<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>ApiForge.Generator</Title>
    <Description>API to generate basic .NET API structure from OpenApi file (.yaml or .json)</Description>
    <PackageIcon>openapi-dotnet-api-icon.png</PackageIcon>
    <PackageTags>API, OpenApi, Generate, .NET, C#, </PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Resources\openapi-dotnet-api-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Resources\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
	  <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
	  <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\ApiForge.Application\ApiForge.ApplicationCore.csproj" />
	  <ProjectReference Include="..\ApiForge.Domain\ApiForge.Domain.csproj" />
	  <ProjectReference Include="..\ApiForge.Generator\ApiForge.Generator.csproj" />
	  <ProjectReference Include="..\ApiForge.Infrastructure\ApiForge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
